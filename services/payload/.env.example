DATABASE_URL=postgres://orbita:orbita@localhost:5432/orbita
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_CODE=replace-with-a-private-code-at-least-16-characters
PAYLOAD_PUBLIC_URL=http://localhost:3001
REALTIME_SECRET=replace-with-a-separate-32-character-random-secret
REALTIME_ORIGIN=http://localhost:4321
REALTIME_PORT=3002

# Must match INTEGRATIONS_SECRET in the Astro frontend server.
INTEGRATIONS_SECRET=replace-with-a-separate-32-character-random-secret
# Use a supported version of your Meta app, e.g. v26.0.
WHATSAPP_GRAPH_VERSION=v26.0

# Enlaces de invitación: dominio del frontend, no el de Payload
SAAS_PUBLIC_URL=http://127.0.0.1:4345
# Opcional: correo automático con dominio remitente verificado en Resend
RESEND_API_KEY=
INVITATION_FROM=

# Optional: dedicated key for encrypted private canvas records. Keep it stable and back it up.
# If unset, a purpose-specific key is derived from PAYLOAD_SECRET.
# PRIVATE_CANVAS_SECRET=replace-with-a-separate-32-character-random-secret
