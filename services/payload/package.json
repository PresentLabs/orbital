{
  "name": "orbita-payload",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "node serve.mjs --dev",
    "build": "next build --webpack",
    "start": "node serve.mjs",
    "check": "tsc --noEmit",
    "realtime": "node --env-file=.env realtime.mjs",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "test": "node --experimental-strip-types --test tests/access.test.mjs tests/images.test.mjs tests/invitations.test.mjs tests/polls.test.mjs tests/private-canvas.test.mjs",
    "retention": "node --experimental-strip-types retention.mjs"
  },
  "dependencies": {
    "payload": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/db-postgres": "3.92.1",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "graphql": "^16.11.0",
    "sharp": "^0.34.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
