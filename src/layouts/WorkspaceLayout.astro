---
import { schedulingSections } from "@/lib/saas/scheduling";
import { isAdmin, canView } from "@/lib/saas/permissions";
import ThemeInit from "@/components/saas/ThemeInit.astro";
import Icon from "@/components/saas/Icon.astro";
import "@/styles/fonts.css";
import "@/styles/global.css";
import "@/styles/workspace.css";
import "@/styles/workspace-ui.css";
import "@/styles/workspace-system.css";
import { payload, setting } from "@/lib/saas/server";
import { validLogo } from "@/lib/saas/formats";
const user = Astro.locals.workspaceUser;
const demo = Astro.url.searchParams.get("demo") === "1";
const platformAdmin = user && setting(Astro, "SAAS_ADMIN_USER_IDS").split(",").map((id) => id.trim()).filter(Boolean).includes(String(user.id));
const branding = user ? await payload(Astro, "branding").catch(() => null) : null;
const enabledModules: string[] = user ? (await payload(Astro, "orbita-module-access").catch(() => ({ modules: [] }))).modules : demo ? ["reservations"] : [];
const workspace = user?.workspace as { id?: number; name?: string } | null | undefined;
const business = branding?.name || workspace?.name || (user ? "Mi negocio" : "Punto Pixel");
const logo = branding?.logoData && validLogo(branding.logoData) ? branding.logoData : "";
const session = user ? {
  id: user.id, name: user.name, firstName: user.firstName, lastName: user.lastName,
  email: user.email, phone: user.phone, jobTitle: user.jobTitle, avatarData: user.avatarData,
  role: user.role, permissions: user.permissions, workspace: { id: workspace?.id ?? user.workspace, name: business },
} : null;
const { title = "Vista general" } = Astro.props;

---

<!doctype html>
<html lang="es">
  <head
    ><ThemeInit /><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex,nofollow" /><meta
      name="theme-color"
      content="#ffffff"
    /><title>{title} · Orbital</title><meta
      name="description"
      content="Tu negocio, tus ideas y tu equipo. Un solo espacio para hacerlo crecer."
    /></head
  >
  <body id="orbita-workspace" class="orbita" data-enabled-modules={JSON.stringify(enabledModules)} data-workspace-user={session ? JSON.stringify(session) : undefined}
    data-branding={branding ? JSON.stringify({ currency: branding.currency, timezone: branding.timezone, palette: branding.palette }) : undefined}
    ><a class="skip-workspace" href="#workspace-main">Ir al contenido</a>
    <button class="sidebar-veil" aria-label="Cerrar navegación" tabindex="-1"></button>
    <aside class="sidebar" id="sidebar" aria-label="Navegación del negocio">
      <div class="mobile-nav-heading"><a class="mobile-nav-brand" href={demo ? "/app?demo=1" : "/app"} aria-label={logo ? business : "Orbital"}>{logo ? <img src={logo} alt={business}/> : <><span class="header-orbit-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"/></svg></span><strong>orbital</strong></>}</a><button class="icon-btn" data-action="menu" aria-label="Cerrar navegación">×</button></div>
      <a href="/app" class="brand" aria-label={logo ? business : "Orbital"}>
        {logo ? <img src={logo} alt={business} class="business-logo" /> :
          (!user || branding) && <><span class="brand-symbol">✳</span> orbital<span class="brand-period">®</span></>}
      </a>
      <button class="sidebar-search" data-action="search" aria-label="Buscar en el negocio" title="Buscar (⌘ K)"
        ><Icon name="search" size={17} /><span>Buscar</span><kbd
          >⌘ K</kbd
        ></button
      >
      <div class="sidebar-navigation" hidden={!!user}><p class="nav-label">INICIO</p>
<nav aria-label="Navegación principal">
        <button class="nav-item" data-view="overview"><Icon name="home" size={19}/><span>Vista general</span></button>
        <div id="store-navigation">
          <button type="button" class="nav-item navigation-parent module-heading" data-action="toggle-store" aria-controls="store-submenu" aria-expanded="false">Tienda<span class="nav-chevron" aria-hidden="true">⌄</span></button>
          <div id="store-submenu" class="store-submenu" hidden>
            <button data-view="analytics">Métricas</button><button data-view="orders">Pedidos</button><button data-view="invoices">Facturas y boletas</button><button data-view="customers">Clientes</button>
          </div>
        </div>
        <div id="company-navigation">
          <button type="button" class="nav-item navigation-parent module-heading" data-action="toggle-company" aria-controls="company-submenu" aria-expanded="false">Empresa<span class="nav-chevron" aria-hidden="true">⌄</span></button>
          <div id="company-submenu" class="store-submenu navigation-submenu" hidden>
            <button class="nav-item" data-view="documents"><span>Documentos</span></button>
            <button class="nav-item" data-view="vault"><span>Accesos</span></button>
            <button class="nav-item" data-view="team"><span>Equipo</span></button><button class="nav-item" data-view="polls"><span>Votaciones</span></button>
          </div>
        </div>
        <div id="creative-navigation">
          <button type="button" class="nav-item navigation-parent module-heading" data-action="toggle-creative" aria-controls="creative-submenu" aria-expanded="false">Proyecto<span class="nav-chevron" aria-hidden="true">⌄</span></button>
          <div id="creative-submenu" class="store-submenu navigation-submenu" hidden>
            <button type="button" class="nav-item project-create" data-action="create"><Icon name="plus" size={16}/>Crear</button>
            <button class="nav-item" title="Conecta ideas en un lienzo" data-view="canvas"><span>Espacios</span></button>
            <button class="nav-item" title="Organiza acciones y pendientes" data-view="tasks"><span>Tareas</span><span id="task-count" class="nav-count">5</span></button>
            <button class="nav-item" data-view="pages"><span>Notas</span></button>
            <button class="nav-item" data-view="calendar"><span>Calendario</span></button>
            <button class="nav-item" data-view="files"><span>Archivos</span></button>
          </div>
        </div>
        {enabledModules.includes("reservations") && (demo || canView(user, "calendar")) && <div id="scheduling-navigation">
          <button type="button" class="nav-item navigation-parent module-heading" data-action="toggle-scheduling" aria-controls="scheduling-submenu" aria-expanded="false">Agendamiento<span class="nav-chevron" aria-hidden="true">⌄</span></button>
          <div id="scheduling-submenu" class="store-submenu navigation-submenu" hidden>
            {schedulingSections.filter((section) => !("admin" in section) || demo || isAdmin(user)).map((section) => <button data-scheduling-section={section.id}>{section.label}</button>)}
          </div>
        </div>}
      <button class="nav-item mobile-accounting" data-view="accounting">Contabilidad</button></nav>
      <div class="sidebar-divider"></div><div class="nav-label space-label">
        <button class="private-index-link" data-action="private-home">MI ÁREA PRIVADA</button><button aria-label="Agregar a mi área privada" data-action="private-create"
          ><Icon name="plus" size={14} /></button>
      </div>
      <div class="private-navigation" id="private-navigation"></div><div id="spaces-list" hidden></div></div>
      <div class="sidebar-bottom">
<button class="nav-item" data-view="settings"
          ><Icon name="settings" size={19} />Configuración</button
        ><div class="plan-card">
          <span class="plan-icon">✧</span><strong>Espacio para crecer</strong><p
          >
            Grandes ideas. Posibilidades infinitas.
          </p><button data-action="plan"
            >Conoce Orbital Pro <span>↗</span></button>
        </div><button class="profile" data-action="profile"
          ><span class="avatar my-avatar" id="profile-avatar">CD</span><span
            ><strong id="profile-name">Hola</strong><small
              id="profile-role">Explora a tu ritmo</small
            ></span
          ><Icon name="more" size={18} /></button>
      </div>
    </aside>
    <div class="app-shell">
      <header class="topbar">
        <a class="header-identity" href="/app" aria-label={logo ? business : "Orbital"}>{logo ? <img src={logo} alt={business}/> : <><span class="header-orbit-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"/></svg></span><strong>orbital</strong></>}</a>
        <nav class="topbar-context" aria-label="Módulos"><button data-shell-module="general">Inicio</button><button data-shell-module="store">Tienda</button><button data-shell-module="company">Empresa</button><button data-shell-module="creative">Proyecto</button><button data-shell-module="scheduling">Agendamiento</button><button data-shell-module="accounting">Contabilidad</button></nav>
        <div class="breadcrumbs">
          <button
            class="icon-btn mobile-toggle"
            aria-label="Abrir navegación"
            data-action="menu"><Icon name="menu" /></button
          ><span>{business}</span><span class="crumb-slash">/</span><strong
            id="breadcrumb">Vista general</strong>
        </div><div class="topbar-right">
          <span class="save-state" id="save-state"
            ><span></span>Guardado en este dispositivo</span
          >{platformAdmin && <a class="icon-btn platform-admin-trigger" href="/administracion" aria-label="Administración SaaS"><Icon name="shield" size={19}/></a>}<button
            class="icon-btn notification-trigger"
            aria-label="Notificaciones"
            data-action="notifications"
            ><Icon name="bell" size={19} /><span class="notification-count" id="notification-count" hidden>0</span><span id="vote-notification" class="vote-notification" hidden aria-hidden="true">Vota</span></button
          ><span class="top-divider"></span><button class="avatar my-avatar small" popovertarget="profile-menu" aria-label="Mi cuenta"
            >CD</button>
        </div>
      <div id="profile-menu" class="profile-menu" popover="auto"><button data-view="profile"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg><span>Mi cuenta</span></button><button class="profile-preference" type="button" data-theme-toggle aria-label="Cambiar a modo oscuro"><Icon name="sun" size={17}/><span class="preference-label"></span></button><button class="profile-preference" id="money-visibility" type="button" data-money-toggle aria-label="Mostrar montos"><Icon name="percent" size={17}/><span class="preference-label"></span></button><button type="button" class="profile-logout" data-action="logout-person"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 4H4v16h6M9 12h12m-5-5 5 5-5 5"/></svg><span>Cerrar sesión</span></button></div>
      </header>
      {user && <p id="workspace-loading" role="status">Cargando tu espacio de trabajo…</p>}
      <main id="workspace-main" tabindex="-1" hidden={!!user}><slot /></main>
      <footer class="app-footer">
        <span
          ><span class="status-dot"></span>Tu negocio, organizado a tu manera.</span
        ><span
          >Orbital · Tu espacio de trabajo <span class="footer-star">✳</span></span>
      </footer>
    </div>
    <dialog id="editor-dialog" class="editor-dialog">
      <button type="button" class="modal-x" data-close aria-label="Cerrar ventana">×</button>
      <div id="dialog-content"></div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import "@/scripts/workspace";
    </script>
  </body>
</html>
