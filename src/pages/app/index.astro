---
import ModulesPanel from "@/components/saas/ModulesPanel.astro";
import WorkspaceLayout from "@/layouts/WorkspaceLayout.astro";
import Icon from "@/components/saas/Icon.astro";
import {smoothLine} from "@/lib/saas/chart-path";
---

<WorkspaceLayout>
  <ModulesPanel />
  <section class="view" data-panel="overview">
    <div class="page-heading">
      <div>
        <div class="eyebrow">
          <span class="sun-glyph">☼</span><span id="greeting-date"
            >DOMINGO, 1 DE NOVIEMBRE</span>
        </div><h1 id="overview-greeting">Hola, ¿cómo va tu día?</h1><p>
          Revisa las ventas, organiza tus pendientes y sigue con lo importante.
        </p>
      </div><button class="button primary" data-action="create"
        ><Icon name="plus" size={17} />Crear nuevo</button>
    </div>
    <div class="home-action-grid">
      <article class="panel month-goals-card"><div class="pill-switch planning-switch" role="group" aria-label="Planificación personal"><button type="button" data-overview-mode="goals" aria-pressed="true">Objetivos del mes</button><button type="button" data-overview-mode="vision" aria-pressed="false">Mi vision board</button></div><div id="monthly-goals-pane"><div class="panel-heading"><div class="goals-heading-copy"><div class="goals-title-line"><h2>Objetivos del mes</h2><span id="goals-month" class="goals-month-pill"></span></div><p class="panel-subtitle">Compartidos con todo el equipo</p></div><button class="button secondary small-button" data-home-action="new-goal">Agregar objetivo</button></div><div id="monthly-goals"></div><footer class="home-card-footer"><div id="goal-progress" class="goal-progress"></div><button class="subtle-button" data-trash-section="overview">Papelera de objetivos</button></footer></div><div id="vision-board-pane" hidden><div data-vision-host></div></div><input type="file" id="vision-image-input" hidden multiple accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"/></article>
      <article class="panel today-panel" aria-labelledby="my-day-title">
        <div class="panel-heading"><div class="my-day-heading-title"><h2 id="my-day-title">Mi día</h2><span id="my-day-count" class="my-day-count" aria-label="Cantidad de prioridades">0</span></div><div class="my-day-heading-actions"><button class="button primary small-button" data-home-action="choose-today">Elegir prioridades</button><button class="icon-btn my-day-add" data-home-action="new-priority" aria-label="Crear tarea prioritaria" title="Crear tarea prioritaria"><Icon name="plus" size={18}/></button></div></div>
        <div id="today-tasks"></div>
        <footer class="my-day-footer home-card-footer"><button class="text-link" data-home-action="my-tasks">Ver mis tareas →</button><button class="subtle-button" data-home-action="daily">Planificar mi día</button></footer>
      </article>
    </div>
    <div class="section-heading" data-store-summary>
      <h2>
        Cómo va el negocio <span class="demo-tag">Datos de ejemplo</span>
      </h2><button class="subtle-button" data-view="analytics"
        >Ver métricas <Icon name="arrow" size={15} /></button>
    </div>
    <div class="metric-grid">
      <article class="metric-card" data-store-summary>
        <div class="metric-top">
          <span>Ventas del mes</span><span class="metric-icon sage"
            ><Icon name="chart" size={17} /></span>
        </div><div class="metric-value">$2.845.900 <small>CLP</small></div><div
          class="metric-bottom"
        >
          <span class="positive">↗ 18,6%</span><span>vs. mes anterior</span><svg
            class="sparkline"
            viewBox="0 0 100 32"
            ><path
              d={smoothLine([[1,27],[10,23],[20,25],[30,16],[40,20],[50,12],[60,15],[70,6],[80,10],[90,5],[99,1]])}
            ></path></svg>
        </div>
      </article><article class="metric-card" data-store-summary>
        <div class="metric-top">
          <span>Pedidos recibidos</span><span class="metric-icon sand"
            ><Icon name="cart" size={17} /></span>
        </div><div class="metric-value">128 <small>pedidos</small></div><div
          class="metric-bottom"
        >
          <span class="positive">↗ 12,3%</span><span>vs. mes anterior</span><svg
            class="sparkline brown"
            viewBox="0 0 100 32"
            ><path d={smoothLine([[1,28],[15,22],[26,24],[37,14],[48,18],[59,10],[70,14],[81,5],[99,2]])}
            ></path></svg>
        </div>
      </article><article class="metric-card">
        <div class="metric-top">
          <span>Tareas completadas</span><span class="metric-icon lavender"
            ><Icon name="check" size={17} /></span>
        </div><div class="metric-value" id="metric-tasks">
          8 <small>/ 13 tareas</small>
        </div><div class="metric-bottom">
          <div class="mini-progress"><span></span></div><span
            id="metric-progress">61% de tu objetivo semanal</span>
        </div>
      </article><article class="metric-card">
        <div class="metric-top">
          <span>Próximo vencimiento</span><span class="metric-icon peach"
            ><Icon name="clock" size={17} /></span>
        </div><div class="metric-value deadline-value">
          05 nov <span class="days-pill">En 4 días</span>
        </div><div class="metric-bottom">
          <span class="space-dot orange"></span><span
            >Lanzamiento de verano</span>
        </div>
      </article>
    </div>
    <div class="overview-grid">
      <article class="panel sales-panel" data-store-summary>
        <div class="panel-heading">
          <h2>Ventas de tu tienda <span class="woo-badge">woo</span></h2><select
            id="sales-period"
            aria-label="Período de ventas"
            ><option value="month">Este mes</option><option value="week"
              >Últimos 7 días</option
            ></select>
        </div><div
          class="chart-tabs"
          role="tablist"
          aria-label="Métricas de tienda"
        >
          <button role="tab" aria-selected="true" data-chart="sales"
            >Ventas</button
          ><button role="tab" aria-selected="false" data-chart="seo">SEO</button
          ><button role="tab" aria-selected="false" data-chart="carts"
            >Carros abandonados <span>12</span></button>
        </div><div class="chart-summary">
          <strong id="chart-total">$2.845.900</strong><span
            class="positive"
            id="chart-delta">↗ 18,6% este mes</span>
        </div><div class="chart-wrap" id="overview-chart"></div><div
          class="chart-legend"
        >
          <span><i></i><span id="chart-legend-name">Este mes</span></span><span
            ><i></i>Mes anterior</span
          ><small>Vista previa · Conecta tu tienda para ver datos reales</small>
        </div>
      </article>
      <article class="panel meet-card"><span class="meet-symbol" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="12" height="12" rx="3"/><path d="m15 10 6-3v10l-6-3z"/></svg></span><h2>Conversa con tu equipo</h2><p>Organiza una reunión en Google Meet y elige a quién invitar.</p><div class="meet-actions"><button class="button primary" data-home-action="new-meeting">Crear reunión</button><button class="button secondary" data-home-action="schedule-meeting">Programar reunión</button></div><div id="meeting-result" aria-live="polite"></div><footer class="home-card-footer"><p id="meet-connection-note" class="section-note"></p></footer></article>
    </div>
    <div class="section-heading spaces-heading">
      <h2>
        Tus espacios <span class="muted-count" id="spaces-count">2</span>
      </h2><div class="heading-actions"><button class="subtle-button" data-view="canvas">Ver todos</button><button class="subtle-button" data-action="new-space"
        ><Icon name="plus" size={15} />Nuevo espacio</button></div>
    </div><div class="workspace-cards" id="workspace-cards"></div>
  </section>
  <section class="view" data-panel="canvas" hidden>
    <div id="spaces-home"><div class="page-heading compact"><div><h1>Espacios del equipo</h1><p>Espacios compartidos con las personas de tu organización.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="canvas"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="new-space"><Icon name="plus" size={17}/>Nuevo espacio</button></div></div><div id="spaces-directory-toolbar"></div><div id="spaces-grid" class="space-directory"></div><div id="spaces-pagination" class="pagination"></div></div>
    <div id="space-editor" hidden>
    <div class="canvas-frame" id="canvas-frame" tabindex="0">
      <header class="canvas-heading">
        <button class="back-to-spaces" data-action="close-space">← Volver a mis espacios</button>
        <h1 id="canvas-title">Mi negocio</h1>
        <div class="heading-actions"><div id="canvas-members" class="canvas-members" aria-label="Personas activas"></div><button class="icon-btn tooltip-control" data-action="delete-space" aria-label="Enviar espacio a la papelera" data-tooltip="Enviar a la papelera"><Icon name="trash"/></button></div>
      </header>
      <div id="canvas-tools-menu" tabindex="-1" class="canvas-tools-menu" role="group" aria-label="Opciones de herramienta" hidden></div>
      <aside class="canvas-block-library" id="canvas-block-library" aria-label="Herramientas del espacio">
        <div class="canvas-library-group" role="group" aria-label="Crear" data-canvas-write>
          {[{id:'page',icon:'page',label:'Notas'},{id:'note',icon:'stickyNote',label:'Sticky notes'},{id:'frame',icon:'ideaCloud',label:'Ideas'}].map(block=>
            <button type="button" class="tooltip-control" aria-label={block.label} data-tooltip={block.label} data-add-block={block.id}><Icon name={block.icon} size={18}/></button>
          )}
          <button type="button" class="tooltip-control" aria-label="Dibujo a mano" data-tooltip="Dibujo a mano" data-spatial-action="sketch"><Icon name="pencil" size={18}/></button>
        </div>
        <div class="canvas-library-group" role="group" aria-label="Recursos" data-canvas-write>
          <button type="button" class="tooltip-control" aria-label="Imagen" data-tooltip="Imagen" data-add-block="image"><Icon name="image" size={18}/></button>
          <button type="button" class="tooltip-control" aria-label="Enlace y recorte web" data-tooltip="Enlace y recorte web" data-spatial-action="web"><Icon name="link" size={18}/></button>
          <button type="button" class="tooltip-control" aria-label="Recurso de Archivos" data-tooltip="Recurso de Archivos" data-spatial-action="media"><Icon name="paperclip" size={18}/></button>
          <button type="button" class="tooltip-control" aria-label="Carpetas" data-tooltip="Carpetas" aria-expanded="false" aria-controls="canvas-tools-menu" data-action="new-canvas-folder"><Icon name="folderPlus" size={18}/></button>
          <button type="button" class="tooltip-control" aria-label="Métricas" data-tooltip="Métricas" aria-expanded="false" aria-controls="canvas-tools-menu" data-action="canvas-metrics"><Icon name="sales" size={18}/></button>
        </div>
      </aside><div class="canvas-viewport" id="canvas-viewport">
        <svg
          id="connections"
          class="connections"
          width="10000"
          height="10000"
          aria-hidden="true"></svg><div id="canvas-nodes"></div><svg id="connection-handles" class="connection-handles" width="10000" height="10000" aria-hidden="true"></svg>
      </div><div id="presence-cursors"></div><div id="canvas-selection-actions" role="status" hidden><span></span></div><div class="canvas-toolbar" role="toolbar" aria-label="Herramientas del lienzo"><button class="icon-btn selected tooltip-control" data-tooltip="Seleccionar" aria-label="Seleccionar" aria-pressed="true" data-tool="select"><Icon name="cursor"/></button><button class="icon-btn tooltip-control" data-tooltip="Seleccionar área" aria-label="Seleccionar área" aria-pressed="false" data-tool="marquee"><Icon name="frame"/></button><button class="icon-btn tooltip-control" data-tooltip="Mover lienzo" aria-label="Mover lienzo" aria-pressed="false" data-tool="hand"><Icon name="hand"/></button><span class="toolbar-divider"></span>        <div class="canvas-toolbar-actions" role="group" aria-label="Acciones">
          <button type="button" class="icon-btn tooltip-control" aria-label="Agrupar" data-tooltip="Agrupar · ⌘ / Ctrl + G" data-spatial-action="stack" data-canvas-write>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
              <path d="M4.75 11C4.75 10.31 5.31 9.75 6 9.75H13C13.69 9.75 14.25 10.31 14.25 11V18C14.25 18.69 13.69 19.25 13 19.25H6C5.31 19.25 4.75 18.69 4.75 18V11Z"/>
              <path d="M9.75 6C9.75 5.31 10.31 4.75 11 4.75H18C18.69 4.75 19.25 5.31 19.25 6V13C19.25 13.69 18.69 14.25 18 14.25H11C10.31 14.25 9.75 13.69 9.75 13V6Z"/>
            </svg>
          </button>
        </div>
</div><div class="zoom-toolbar" role="toolbar" aria-label="Zoom del lienzo"><button class="tooltip-control" data-tooltip="Alejar" aria-label="Reducir zoom" data-action="zoom-out"><Icon name="minus" size={17}/></button><button id="zoom-value" data-action="zoom-reset" aria-label="Restablecer zoom">100%</button><button class="tooltip-control" data-tooltip="Acercar" aria-label="Aumentar zoom" data-action="zoom-in"><Icon name="plus" size={17}/></button><span class="toolbar-divider"></span><button class="tooltip-control" data-tooltip="Ver todas las tarjetas" aria-label="Centrar lienzo" data-action="fit"><Icon name="fit" size={18}/></button></div><div class="canvas-brand-tools"><button type="button" class="icon-btn tooltip-control" data-action="canvas-shortcuts" aria-controls="canvas-tools-menu" aria-expanded="false" aria-label="Atajos del lienzo" data-tooltip="Atajos del lienzo"><Icon name="keyboard" size={19}/></button><span class="canvas-watermark">✳ orbital</span></div>
      <section id="canvas-detail" aria-label="Detalle del elemento" hidden></section>
    </div>
  </div>
  </section>
  <section class="view" data-panel="tasks" hidden><div id="personal-tasks-home" hidden></div><div id="task-projects-home"><div class="page-heading compact"><div><h1>Tableros del equipo</h1><p>Organiza el trabajo diario y los proyectos.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="tasks"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="new-board"><Icon name="plus" size={17}/>Nuevo tablero</button></div></div><div id="task-directory-content"><div id="tasks-directory-toolbar"></div><div id="task-project-grid" class="task-project-grid"></div><div id="tasks-pagination" class="pagination"></div></div></div><div id="task-board-editor" hidden><button class="back-link" data-action="back-boards">← Volver a mis tableros</button>
    <div class="page-heading compact"><div><div class="board-title-line"><h1>Tablero</h1><span class="work-mode-badge" id="board-work-mode"></span></div><p id="board-description"></p></div><div class="heading-actions"><details class="board-menu"><summary aria-label="Acciones del tablero">···</summary><div id="board-secondary-menu"></div></details><button class="button primary" data-action="new-task"><Icon name="plus" size={17}/>Nueva tarea</button></div></div>
    <div id="board-active-work"></div><div class="work-tabs" role="tablist" aria-label="Contenido del tablero"><button role="tab" data-board-tab="board" aria-selected="true" aria-controls="board-main-pane">Tablero</button><button role="tab" data-board-tab="summary" aria-selected="false" aria-controls="board-summary-pane">Resumen</button><button role="tab" data-board-tab="progress" aria-selected="false" aria-controls="board-progress-pane">Avance</button></div><div id="board-main-pane" role="tabpanel"><div class="view-toolbar task-board-toolbar"><div class="task-board-filters"><label class="filter-search"><Icon name="search" size={17}/><input id="task-search" placeholder="Buscar tareas…" aria-label="Buscar tareas"/></label><select id="task-filter" aria-label="Filtrar por prioridad"><option value="all">Todas las prioridades</option><option value="high">Prioridad alta</option><option value="normal">Prioridad normal</option></select><select id="cycle-task-filter" aria-label="Tareas del ciclo" hidden><option value="all">Todas las tareas</option><option value="current">Ciclo actual</option></select></div><div class="task-board-display"><button class="button secondary" data-action="toggle-task-comments" aria-pressed="false">Mostrar comentarios</button><div class="segmented task-mode-switch" role="group" aria-label="Vista de tareas"><button class="active" data-task-mode="board">Kanban</button><button data-task-mode="list">Lista</button></div></div></div><div id="kanban-board" class="kanban-board"></div></div><div id="board-summary-pane" role="tabpanel" hidden></div><div id="board-progress-pane" role="tabpanel" hidden></div>
  </div></section>
  <section class="view" data-panel="calendar" hidden>
    <div class="page-heading compact">
      <div>
        <h1>
          Tu <span>calendario</span>
        </h1><p>Reuniones, entregas y fechas que no quieres pasar por alto.</p>
      </div><div class="heading-actions">
        <button class="button secondary" data-action="google"
          ><span class="google-mark">G</span>Google Calendar</button
        ><button class="button primary" data-action="new-event"
          ><Icon name="plus" size={17} />Nuevo evento</button>
      </div>
    </div><div class="panel calendar-panel" tabindex="0" role="region" aria-label="Calendario mensual. Desplaza horizontalmente para ver todos los días.">
      <div class="panel-heading">
        <h2 id="calendar-month"></h2><div class="heading-actions">
          <button
            class="button secondary small-button"
            data-action="calendar-today">Hoy</button
          ><button
            class="icon-btn"
            aria-label="Mes anterior"
            data-action="calendar-prev">‹</button
          ><button
            class="icon-btn"
            aria-label="Mes siguiente"
            data-action="calendar-next">›</button>
        </div>
      </div><div class="calendar-weekdays">
        {
          ["LUN", "MAR", "MIÉ", "JUE", "VIE", "SÁB", "DOM"].map((d) => (
            <span>{d}</span>
          ))
        }
      </div><div class="calendar-grid" id="calendar-grid"></div>
    </div>
  </section>
  <section class="view" data-panel="analytics" hidden>
    <div class="page-heading compact">
      <div>
        <h1>
          Los números de <span>tu negocio</span>
        </h1><p>Ventas, posicionamiento y oportunidades de tu tienda.</p>
      </div><button class="button secondary" data-action="export-csv"
        ><Icon name="export" size={17} />Exportar CSV</button>
    </div><div class="integration-notice">
      <span class="woo-badge">woo</span><div>
        <strong>Tu tienda tiene mucho que contarte.</strong><p>
          Estás viendo datos de ejemplo. Conecta WooCommerce para consultar
          ventas reales.
        </p>
      </div><button class="button secondary" data-view="integrations"
        >Conectar tienda <Icon name="arrow" size={15} /></button>
    </div><article class="panel analytics-full">
      <div class="chart-tabs" role="tablist" aria-label="Métricas">
        <button role="tab" aria-selected="true" data-analytics="sales"
          >Ventas</button
        ><button role="tab" aria-selected="false" data-analytics="seo"
          >Posicionamiento SEO</button
        ><button role="tab" aria-selected="false" data-analytics="carts"
          >Carros abandonados</button>
      </div><div id="analytics-content"></div>
    </article>
  </section>
  <section class="view" data-panel="pages" hidden>
    <div class="page-heading compact">
      <div>
        <h1>
          Notas
        </h1><p>Acuerdos, guías e ideas de tu equipo.</p>
      </div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="pages"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="new-page"
        ><Icon name="plus" size={17} />Crear nota</button></div>
    </div><div id="notes-directory-toolbar"></div><div id="pages-list" class="pages-grid"></div><div id="notes-pagination" class="pagination"></div>
  </section>
  <section class="view" data-panel="vault" hidden><div class="page-heading compact"><div><h1>Accesos del negocio</h1><p>Ten a mano las cuentas de tus plataformas, redes sociales y hosting.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="vault"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="new-access"><Icon name="plus" size={17}/>Nuevo acceso</button></div></div><div class="section-note" id="vault-note"></div><div class="view-toolbar"><label class="filter-search"><Icon name="search" size={17}/><input id="vault-search" aria-label="Buscar accesos" placeholder="Buscar una plataforma…"/></label><select id="vault-category" aria-label="Filtrar accesos"><option value="all">Todas las categorías</option><option>Plataformas</option><option>Redes sociales</option><option>Hosting</option><option>Otros</option></select></div><div class="vault-grid" id="vault-grid"></div></section>
  <section class="view" data-panel="polls" hidden><div class="page-heading compact"><div><h1>Votaciones del equipo</h1><p>Decidan juntos y vean los resultados en un solo lugar.</p></div><button class="button primary" id="new-poll"><Icon name="plus" size={17}/>Nueva votación</button></div><div id="polls-list" class="polls-grid" aria-live="polite"></div></section>
  <section class="view" data-panel="team" hidden><div class="page-heading compact"><div><h1>Tu equipo</h1><p>Añade personas y decide qué puede ver cada una.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="team"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="new-member"><Icon name="plus" size={17}/>Añadir persona</button></div></div><div class="section-note" id="team-note"></div><div class="panel team-panel" tabindex="0" role="region" aria-label="Listado del equipo"><div id="team-list"></div></div></section>
  <section class="view" data-panel="blocked" hidden><div class="empty-state"><h1>No tienes acceso a esta sección</h1><p>Pide a quien administra tu equipo que revise tus permisos.</p><button class="button secondary" data-action="profile">Ver mi cuenta</button></div></section>
  <section class="view" data-panel="settings" hidden><div class="page-heading compact"><div><h1>Configuración del negocio</h1><p>Actualiza la información, la marca y las herramientas del equipo.</p></div></div><div class="settings-layout"><div class="settings-tabs strong-tabs" role="tablist" aria-label="Configuración" aria-orientation="vertical"><button type="button" role="tab" aria-selected="true" data-settings-tab="company">Empresa</button><button type="button" role="tab" aria-selected="false" data-settings-tab="brand">Logo y marca</button><button type="button" role="tab" aria-selected="false" data-settings-tab="preferences">Preferencias</button><button type="button" role="tab" aria-selected="false" data-settings-tab="social">Redes sociales</button><button type="button" role="tab" aria-selected="false" data-settings-tab="integrations">Integraciones</button></div><form id="settings-form" class="panel settings-panel"><div data-settings-panel="company"><h2>Información de la empresa</h2><div class="form-grid"><label>Nombre o razón social<input name="name" required maxlength="80"/></label><label>RUT<input name="rut" placeholder="12.345.678-5" maxlength="14" inputmode="text"/></label><label class="full-field">Giro principal<input name="giro" maxlength="160" placeholder="Por ejemplo, desarrollo de software"/></label><label>Teléfono de contacto<input name="phone" type="tel" placeholder="(+56) 9 8268 0615" autocomplete="tel"/></label><label>Correo de contacto<input name="email" type="email" placeholder="hola@tunegocio.cl"/></label></div></div><div data-settings-panel="social" hidden><h2>Redes sociales</h2><p>Guarda los enlaces públicos de las redes de tu negocio.</p><div class="form-grid"><label>Instagram<input type="url" name="social-instagram" placeholder="https://" maxlength="500"/></label><label>Facebook<input type="url" name="social-facebook" placeholder="https://" maxlength="500"/></label><label>TikTok<input type="url" name="social-tiktok" placeholder="https://" maxlength="500"/></label><label>LinkedIn<input type="url" name="social-linkedin" placeholder="https://" maxlength="500"/></label><label>YouTube<input type="url" name="social-youtube" placeholder="https://" maxlength="500"/></label><label>Pinterest<input type="url" name="social-pinterest" placeholder="https://" maxlength="500"/></label><label>X<input type="url" name="social-x" placeholder="https://" maxlength="500"/></label></div></div><div data-settings-panel="brand" hidden><h2>Logo del negocio</h2><p>Reemplaza la marca de Orbital por el logo de tu organización.</p><div id="logo-preview" class="logo-preview">✳</div><label class="file-label">Subir logo<input id="logo-upload" type="file" accept="image/png,image/svg+xml"/></label><p class="field-hint">SVG o PNG · hasta 250 KB</p><button class="button secondary" type="button" id="remove-logo">Usar logo de Orbital</button></div><div data-settings-panel="preferences" hidden><h2>Preferencias</h2><div class="form-grid"><label>Moneda<select name="currency"><option value="CLP">Peso chileno · CLP</option><option value="USD">Dólar · USD</option><option value="EUR">Euro · EUR</option></select></label><label>Zona horaria<select name="timezone"><option>America/Santiago</option><option>America/Mexico_City</option><option>Europe/Madrid</option></select></label></div><div class="settings-divider"></div><h2>Copias de tu información</h2><p>Exporta los tableros, las tareas, las notas y los espacios que puedes ver. Los accesos sensibles se guardan aparte.</p><div class="heading-actions"><button type="button" class="button secondary" data-action="export">Exportar JSON</button><button type="button" class="button secondary" data-action="import">Importar respaldo</button></div></div><p class="form-error" id="settings-error" role="alert"></p><button class="button primary" type="submit">Guardar cambios</button></form><div data-settings-panel="integrations" hidden><div id="integrations-grid" class="integrations-grid"></div></div></div></section>
  <section class="view" data-panel="profile" hidden><div class="page-heading compact"><div><h1>Mi perfil</h1><p>Así te ve el resto del equipo.</p></div></div><form id="profile-form" class="panel settings-panel"><input id="avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" hidden/><div class="profile-intro"><button type="button" id="avatar-upload-trigger" class="avatar-picker" aria-label="Cambiar foto de perfil"><span id="person-avatar" class="large-avatar">A</span><span class="avatar-camera"><Icon name="camera" size={15}/></span></button><div><strong id="person-display-name"></strong><small>Haz clic en tu foto para cambiarla. La ajustamos automáticamente.</small><span id="person-access-role" class="role-tag"></span></div></div><div class="form-grid"><label>Nombre<input name="firstName" required maxlength="80" autocomplete="given-name"/></label><label>Apellido<input name="lastName" maxlength="80" autocomplete="family-name"/></label><label>Negocio<select id="profile-workspace" aria-describedby="profile-workspace-hint"></select><small id="profile-workspace-hint">Tu cuenta tiene acceso a este negocio.</small></label><label>Rol de acceso<select name="accessRole" disabled></select><small>Los permisos se gestionan en Equipo.</small></label><label>Teléfono<input name="phone" type="tel" autocomplete="tel" placeholder="(+56) 9 8268 0615"/></label></div><p id="profile-error" class="form-error" role="alert"></p><div class="heading-actions"><button class="button primary">Guardar mi perfil</button><button type="button" class="button secondary" data-action="logout-person">Cerrar sesión</button></div></form>
    <form id="profile-password" method="post" action="/api/saas/profile/password" class="panel settings-panel" hidden>
      <h2>Cambiar contraseña</h2>
      <div class="form-grid">
        <label>Contraseña actual<input name="currentPassword" type="password" autocomplete="current-password" required maxlength="128"/></label>
        <label>Nueva contraseña<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/></label>
        <label>Repite la nueva contraseña<input name="confirm" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/></label>
      </div>
      <p role="status"></p>
      <button class="button primary" type="submit">Cambiar contraseña</button>
    </form>
  </section>
  <section class="view" data-panel="documents" hidden><div class="page-heading compact"><div><h1>Documentos del negocio</h1><p>Documentos legales y administrativos de tu empresa.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="documents"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="upload-document"><Icon name="plus" size={17}/>Subir documento</button></div></div><div id="documents-note" class="section-note"></div><div class="view-toolbar documents-toolbar"><div class="document-filters"><input id="document-search" placeholder="Buscar documento…" aria-label="Buscar documento"/><div class="file-type-actions"><select id="document-filter" aria-label="Tipo de documento"><option value="all">Todos los documentos</option><option value="application/pdf">PDF</option><option value="image/">Imágenes</option><option value="text/">Texto</option></select></div></div><div class="document-display-controls"><details class="selection-menu document-bulk-toolbar"><summary><span id="document-selection-count" aria-live="polite">0 seleccionados</span><span aria-hidden="true">⌄</span></summary><div class="selection-menu-panel"><label><input id="document-select-all" type="checkbox"/>Seleccionar visibles</label><button id="download-document-zip" class="button primary" disabled>Descargar ZIP</button><button id="delete-selected-documents" class="button secondary" disabled><Icon name="trash" size={16}/>Eliminar</button></div></details><div class="segmented document-view-switch" role="group" aria-label="Vista de documentos"><button type="button" data-document-view="grid" aria-label="Ver documentos en grilla" aria-pressed="true"><Icon name="grid" size={17}/></button><button type="button" data-document-view="list" aria-label="Ver documentos en lista" aria-pressed="false"><Icon name="list" size={17}/></button></div><label><select id="document-page-size" aria-label="Documentos por página"><option value="8">8</option><option value="12" selected>12</option><option value="24">24</option><option value="48">48</option></select></label></div></div><div id="document-grid" class="document-grid"></div><div id="documents-pagination" class="pagination"></div></section>
  <section class="view file-library-view" data-panel="files" hidden>
    <div class="page-heading compact"><div><h1>Archivos</h1><p>Los recursos de tu equipo, en un solo lugar.</p></div><div class="heading-actions"><button class="button secondary trash-button" id="workspace-files-trash"><Icon name="trash" size={16}/>Papelera</button><button type="button" class="button secondary" id="workspace-files-empty-trash" hidden>Vaciar papelera</button><button class="button primary" id="workspace-files-upload"><Icon name="plus" size={17}/>Subir archivos</button></div></div>

    <div id="workspace-file-dropzone" class="workspace-file-dropzone"><Icon name="folder" size={28}/><div><strong>Suelta tus archivos aquí</strong><p id="workspace-file-drop-target">Se guardarán en la biblioteca.</p></div><button id="workspace-drop-choose" hidden>Elegir archivos</button></div>
    <input type="file" id="workspace-files-input" multiple hidden accept=".pdf,.png,.jpg,.jpeg,.webp,.gif,.txt,.md,.csv,.zip,.docx,.xlsx,.pptx,.mp3,.wav,.ogg,.mp4,.webm"/>
    <p id="workspace-files-trash-note" class="section-note" hidden>Los archivos de la papelera se conservan durante 30 días.</p>
    <div class="file-library-surface"><div class="file-folder-context" id="workspace-folder-context" hidden><button class="subtle-button" data-library-root data-folder-drop=""><span aria-hidden="true">←</span> Volver a archivos</button><h2 id="workspace-current-folder"></h2><div id="workspace-folder-actions" class="heading-actions" hidden><button class="button secondary" id="workspace-folder-add"><Icon name="plus" size={16}/>Añadir existentes</button><button class="button secondary" id="workspace-folder-zip"><Icon name="export" size={16}/>Descargar ZIP</button></div></div><div class="view-toolbar workspace-files-toolbar" role="toolbar" aria-label="Herramientas de archivos"><div class="asset-filters"><label class="filter-search"><Icon name="search" size={16}/><input id="workspace-file-search" placeholder="Buscar archivos…" aria-label="Buscar archivos"/></label><div class="file-type-actions"><select id="workspace-file-filter" aria-label="Tipo de archivo"><option value="all">Todos los tipos</option><option value="image">Imágenes</option><option value="pdf">PDF</option><option value="text">Texto y CSV</option><option value="office">Office</option><option value="video">Videos</option><option value="audio">Audio</option><option value="archive">ZIP</option></select></div></div><div class="asset-display-controls"><details class="selection-menu asset-bulk"><summary><span id="workspace-files-count" aria-live="polite">0 seleccionados</span><span aria-hidden="true">⌄</span></summary><div class="selection-menu-panel"><label><input type="checkbox" id="workspace-files-all"/>Seleccionar visibles</label><button class="button primary" id="workspace-files-download" data-assets-bulk="download" disabled>Descargar ZIP</button><button class="button secondary" id="workspace-files-move" data-assets-bulk="move" disabled><Icon name="folder" size={16}/>Mover a carpeta</button><button class="button secondary" id="workspace-files-delete" data-assets-bulk="delete" disabled><Icon name="trash" size={16}/>Eliminar</button><button class="button secondary" id="workspace-files-restore" data-assets-bulk="restore" disabled hidden>Restaurar</button></div></details><div class="segmented" role="group" aria-label="Vista de archivos"><button type="button" data-assets-view="grid" aria-label="Ver archivos en grilla" aria-pressed="true"><Icon name="grid" size={17}/></button><button type="button" data-assets-view="list" aria-label="Ver archivos en lista" aria-pressed="false"><Icon name="list" size={17}/></button></div><label>Por página<select id="workspace-files-page-size" aria-label="Archivos por página"><option>8</option><option selected>12</option><option>24</option><option>48</option></select></label></div></div>
    <div class="file-library-body"><nav id="workspace-folder-sidebar" class="file-folder-sidebar" aria-label="Carpetas" hidden></nav><div class="file-library-content"><section id="workspace-folder-section" class="file-content-section"><h2>Carpetas <span id="workspace-folder-total"></span></h2><div id="workspace-file-folders" class="file-folders-grid" aria-label="Carpetas del equipo"></div></section><div class="file-section-heading"><h2 id="workspace-file-section-title">Archivos</h2><span class="file-drop-hint">Arrastra archivos para subirlos</span></div>
    <p id="workspace-files-status" role="status" class="asset-status"></p><progress id="workspace-upload-progress" class="workspace-upload-progress" aria-label="Progreso de carga de archivos" hidden></progress><div id="workspace-files-grid" class="workspace-files-grid"></div><div id="workspace-files-pagination" class="pagination"></div></div></div><footer class="file-library-help"><strong>Formatos y límites</strong><p>Hasta 20 MB por archivo. Puedes cargar varios a la vez. Las imágenes se optimizan y, si superan 1600 px, se redimensionan manteniendo su proporción. Cada ZIP admite hasta 100 MB.</p></footer>
</div>  </section>
  <section class="view document-detail" data-panel="document" hidden><div id="document-viewer"></div></section>
  <section class="view" data-panel="orders" hidden><div class="page-heading compact"><div><h1>Pedidos de la tienda</h1><p>Revisa los pedidos y abre sus detalles.</p></div><button class="button secondary" data-action="refresh-orders">Actualizar</button></div><div id="orders-note" class="section-note"></div><div class="panel table-panel" tabindex="0" role="region" aria-label="Listado de pedidos"><div id="orders-table"></div></div><div id="orders-pagination" class="pagination"></div></section>
  <section class="view" data-panel="invoices" hidden><button class="button secondary" data-view="modules">Abrir Facturación propia →</button><div class="page-heading compact"><div><h1>Facturas y boletas</h1><p>Comprobantes emitidos y el pedido al que corresponden.</p></div><button class="button primary" data-action="upload-receipt">↑ Subir comprobante</button></div><div id="receipts-note" class="section-note"></div><div class="receipt-filters"><label>Tipo de comprobante<select id="receipt-kind-filter"><option value="all">Facturas y boletas</option><option value="factura">Solo facturas</option><option value="boleta">Solo boletas</option></select></label><label>Buscar por número de pedido<input id="receipt-order-search" type="search" placeholder="Por ejemplo, 1001" inputmode="numeric"/></label></div><div class="panel table-panel" id="receipts-table" tabindex="0" role="region" aria-label="Facturas y boletas"></div></section>
  <section class="view" data-panel="order" hidden><div id="order-detail"></div></section>
  <input id="document-upload" type="file" accept="application/pdf,image/png,image/jpeg,image/webp,text/plain,text/markdown,text/csv" hidden/>
  <input
    id="image-input"
    type="file"
    accept="image/png,image/jpeg,image/webp,image/gif"
