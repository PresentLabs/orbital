  /><input id="import-input" type="file" accept="application/json" hidden />
<section class="view" data-panel="private" hidden><div class="page-heading compact"><div><div class="eyebrow">MI ÁREA PRIVADA</div><h1 id="private-title"></h1><p>Solo tú puedes ver y editar estos elementos.</p></div><div class="heading-actions"><button class="button secondary trash-button" data-trash-section="all" data-trash-private="true"><Icon name="trash" size={16}/>Papelera</button><button class="button primary" data-action="private-new">Agregar</button></div></div><div id="private-directory-toolbar"></div><div id="private-grid" class="private-grid"></div><div id="private-pagination" class="pagination"></div></section><section class="view" data-panel="task" hidden><div id="task-detail"></div></section><section class="view" data-panel="page" hidden><div id="page-detail"></div></section><section class="view" data-panel="search" hidden><div id="all-search-results"></div></section><section class="view" data-panel="event" hidden><div id="event-detail"></div></section><section class="view" data-panel="trash" hidden><div id="trash-content"></div></section><section class="view" data-panel="customers" hidden><div id="customers-content"></div></section><section class="view" data-panel="customer" hidden><div id="customer-content"></div></section><section class="view" data-panel="private-index" hidden><div id="private-index-content"></div></section></WorkspaceLayout>
